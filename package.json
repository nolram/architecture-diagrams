{
  "name": "architecture-diagrams",
  "version": "0.1.0",
  "description": "Motor de diagramas de arquitetura de software ricos e profissionais, feito para ser usado por IA",
  "type": "module",
  "bin": {
    "arch-diagram": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "render": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "validate:skill": "node scripts/validate-skill.mjs",
    "validate:icons": "tsx scripts/validate-icon-catalog.mts",
    "package:skill": "rm -f architecture-diagrams.skill && cd architecture-diagrams && zip -rq ../architecture-diagrams.skill . -x '*.DS_Store' && cd .."
  },
  "license": "MIT",
  "dependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@resvg/resvg-js": "^2.6.2",
    "commander": "^15.0.0",
    "elkjs": "^0.12.0",
    "thesvg": "^3.3.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
